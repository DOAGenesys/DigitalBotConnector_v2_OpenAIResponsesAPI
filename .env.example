# Copy to .env.local for local development. Never commit real values.

PORT=3000
LOG_LEVEL=info

# Shared secret that Genesys Cloud sends in the GENESYS_CONNECTION_SECRET header.
GENESYS_CONNECTION_SECRET=<YOUR_GENESYS_CONNECTION_SECRET>

# Your OpenAI API key (sk-...). Leave empty to use the OPENAI_API_KEY credential of the Genesys integration.
OPENAI_API_KEY=

# Supported models: gpt-6.1-terra, gpt-6-luna
DEFAULT_OPENAI_MODEL=gpt-6.1-terra
# none, low, medium, high, xhigh, max
DEFAULT_OPENAI_REASONING_EFFORT=low
# Only sent when the reasoning effort is "none".
DEFAULT_OPENAI_TEMPERATURE=0.7
# Optional: low, medium, high
DEFAULT_OPENAI_VERBOSITY=
OPENAI_TIMEOUT_MS=25000
# Optional prefix for the OpenAI prompt_cache_key.
PROMPT_CACHE_KEY_PREFIX=

# Optional JSON file with hosted OpenAI tools (remote MCP servers, web search, ...).
MCP_SERVERS_CONFIG_PATH=./mcp_config.json

# memory (local testing) or redis (production / serverless)
SESSION_STORE_TYPE=memory
KV_REST_API_URL=<YOUR_KV_REST_API_URL>
KV_REST_API_TOKEN=<YOUR_KV_REST_API_TOKEN>

# Genesys Data Actions as OpenAI tools
ENABLE_GENESYS_FUNCTION_TOOLS=true
GENESYS_CLIENT_ID=<YOUR_GENESYS_OAUTH_CLIENT_ID>
GENESYS_CLIENT_SECRET=<YOUR_GENESYS_OAUTH_CLIENT_SECRET>
# Host suffix of your region (for example mypurecloud.de), or set the two URLs below.
GENESYS_REGION=
GENESYS_BASE_URL=
GENESYS_LOGIN_URL=
# Pipe-separated allowlist of Data Action IDs.
GENESYS_ALLOWED_DATA_ACTION_IDS=
MAX_GENESYS_TOOLS_PER_TURN=20
GENESYS_TOOL_LOOP_MAX_ITERATIONS=3
GENESYS_MAX_ACTION_CALLS_PER_TURN=10
GENESYS_MAX_TOOL_ARGUMENT_BYTES=16384
GENESYS_ACTIONS_PER_MINUTE=30
# Comma-separated dot paths removed from Data Action results, e.g. customer.email
TOOL_OUTPUT_REDACTION_FIELDS=
GENESYS_TOOLS_STRICT_MODE=false
GENESYS_TOKEN_CACHE_TTL_SECONDS=3000
GENESYS_HTTP_TIMEOUT_MS=10000
GENESYS_HTTP_RETRY_MAX=3
GENESYS_HTTP_RETRY_BACKOFF_MS=250
